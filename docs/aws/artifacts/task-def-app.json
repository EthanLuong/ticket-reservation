{
  "family": "ticket-reservation-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "2048",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::119004747116:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::119004747116:role/ticket-reservation-task-role",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "119004747116.dkr.ecr.us-east-2.amazonaws.com/reservation-service:REPLACED_BY_WORKFLOW",
      "essential": true,
      "memory": 1280,
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" },
        { "name": "SPRING_DATASOURCE_URL", "value": "jdbc:postgresql://ticket-reservation-db.czc0aweocw7v.us-east-2.rds.amazonaws.com:5432/ticketreservation" },
        { "name": "SPRING_DATASOURCE_USERNAME", "value": "postgres" },
        { "name": "SPRING_DATA_REDIS_URL", "value": "redis://ticket-reservation-redis.9g7r90.ng.0001.use2.cache.amazonaws.com:6379" },
        { "name": "SPRING_KAFKA_BOOTSTRAP_SERVERS", "value": "10.0.13.180:9092" },
        { "name": "APP_CORS_ALLOWED_ORIGINS", "value": "https://d1bsa4m1s90vp2.cloudfront.net" },
        { "name": "JAVA_TOOL_OPTIONS", "value": "-XX:MaxRAMPercentage=75" }
      ],
      "secrets": [
        { "name": "SPRING_DATASOURCE_PASSWORD", "valueFrom": "arn:aws:ssm:us-east-2:119004747116:parameter/ticketres/prod/db-password" },
        { "name": "APP_SECURITY_JWT_SECRET", "valueFrom": "arn:aws:ssm:us-east-2:119004747116:parameter/ticketres/prod/jwt-secret" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ticket-reservation",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "app",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:8080/actuator/health | grep -q UP || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    },
    {
      "name": "payment",
      "image": "119004747116.dkr.ecr.us-east-2.amazonaws.com/payment-service:REPLACED_BY_WORKFLOW",
      "essential": true,
      "memory": 768,
      "portMappings": [{ "containerPort": 8081, "protocol": "tcp" }],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" },
        { "name": "SPRING_DATASOURCE_URL", "value": "jdbc:postgresql://ticket-reservation-db.czc0aweocw7v.us-east-2.rds.amazonaws.com:5432/payments" },
        { "name": "SPRING_KAFKA_BOOTSTRAP_SERVERS", "value": "10.0.13.180:9092" },
        { "name": "JAVA_TOOL_OPTIONS", "value": "-XX:MaxRAMPercentage=75" }
      ],
      "secrets": [
        { "name": "PAYMENT_DB_PASSWORD", "valueFrom": "arn:aws:ssm:us-east-2:119004747116:parameter/ticketres/prod/payment-db-password" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ticket-reservation",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "payment",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:8081/actuator/health | grep -q UP || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
